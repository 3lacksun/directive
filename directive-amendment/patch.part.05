+
+private fun taskDeadlineLabel(task:TaskEntity):String? {
+    val zone=ZoneId.systemDefault()
+    task.dueAt?.let { due ->
+        val value=Instant.ofEpochMilli(due).atZone(zone)
+        return "Deadline ${formatDirectiveDate(value.toLocalDate())} ${formatDirectiveTime(value.toLocalTime())}"
+    }
+    task.allDayDueDate?.let { raw ->
+        runCatching { LocalDate.parse(raw) }.getOrNull()?.let { return "Deadline ${formatDirectiveDate(it)}" }
+    }
+    return null
+}
