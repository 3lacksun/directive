+    fun toggleSubtask(task:TaskEntity)=viewModelScope.launch {
+        if(task.status==TaskStatus.COMPLETED) {
+            repository.uncomplete(task.id,System.currentTimeMillis())
+            repository.get(task.id)?.let { reminderCoordinator.restoreForTask(it) }
+        } else {
+            repository.complete(task.id,System.currentTimeMillis())
+            reminderCoordinator.cancelForTask(task.id)
+        }
+    }
+
